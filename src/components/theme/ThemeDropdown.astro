---
import Sun from "@lucide/astro/icons/sun";
import Moon from "@lucide/astro/icons/moon";
import ThemePicker from "./ThemePicker.astro";
import ColorPicker from "./ColorPicker.astro";

import { DEFAULT_LOCALE, type Locale } from "@/i18n/constants";
import { useTranslations } from "@/i18n/helpers";
const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<details id="themeDropdown" class="dropdown dropdown-end">
  <summary
    tabindex="0"
    role="button"
    title={t("theme")}
    class="navbar-link-icon theme-options"
  >
    <Sun data-icon="light" />
    <Moon data-icon="dark" />
  </summary>
  <div class="dropdown-content">
    <div class="content">
      <ThemePicker />
      <ColorPicker />
    </div>
  </div>
</details>

<style>
  .theme-options {
    display: inline-flex;
    -webkit-user-select: none;
    user-select: none;

    [data-icon] {
      transition-property: scale, rotate;
      transition-timing-function: var(--default-transition-timing-function);
      transition-duration: var(--default-transition-duration);
    }
    [data-icon="light"] {
      &:not(:is(.light *)) {
        @media (prefers-color-scheme: dark) {
          scale: 0;
          rotate: -90deg;
        }
      }
      &:is(.dark *) {
        scale: 0;
        rotate: -90deg;
      }
    }
    [data-icon="dark"] {
      position: absolute;
      &:not(:is(.dark *)) {
        @media (prefers-color-scheme: light) {
          scale: 0;
          rotate: -90deg;
        }
      }
      &:is(.light *) {
        scale: 0;
        rotate: -90deg;
      }
    }
  }

  .dropdown-content {
    z-index: 10;
    margin-right: calc(var(--spacing) * -2);
    margin-top: calc(var(--spacing) * 4);
  }

  .content {
    background-color: var(--background);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1);
    border-radius: var(--radius-xl);
    border-width: 1px;
    padding: calc(var(--spacing) * 2);
  }
</style>
