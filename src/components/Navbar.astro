---
import Hamburger from "@/assets/hamburger.svg";
import Logo from "@/assets/logo.svg";
import LocaleSelector from "./LocaleSelector.astro";
import type { Locale } from "@/i18n/constants";
import { useTranslations } from "@/i18n/helpers";
import ThemeDropdown from "./theme/ThemeDropdown.astro";

const locale = Astro.currentLocale as Locale | undefined;
const t = useTranslations(locale);

const menu = [
  {
    href: `/${locale}/blog`,
    label: "Blog",
  },
  {
    href: `/${locale}/about-me`,
    label: t("aboutMe"),
  },
];
---

<nav class="navbar" id="mainNavbar">
  <div class="navbar-container">
    <div class="navbar-bar liquid-glass">
      <a
        aria-current={Astro.url.pathname === `/${locale}` ? "page" : "false"}
        class="navbar-link-icon"
        href={`/${locale}`}
        title={t("home")}
      >
        <Logo class="size-5" />
        <span class="sr-only">{t("home")}</span>
      </a>
    </div>
    <div class="navbar-bar liquid-glass" id="mainMenu" popover="auto">
      {
        menu.map((item) => (
          <a
            aria-current={
              Astro.url.pathname.startsWith(item.href) ? "page" : "false"
            }
            class="navbar-link"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="flex gap-x-4">
      <div class="navbar-bar liquid-glass">
        <LocaleSelector />
        <ThemeDropdown />
      </div>
      <div class="navbar-bar liquid-glass sm:!hidden">
        <button
          aria-label={t("navbar.toggleMenu")}
          class="navbar-link-icon"
          popovertarget="mainMenu"
        >
          <Hamburger class="size-5" />
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  let prevScrollY = window.scrollY;
  const handleScroll = () => {
    const navbar = document.getElementById("mainNavbar");
    if (!navbar) return;
    const hideClassList = "delay-300 -translate-y-full".split(" ");
    const { offsetHeight } = navbar;
    const { scrollY } = window;
    const isActive = scrollY > offsetHeight;
    const isScrollDown = scrollY > prevScrollY;
    if (isActive && isScrollDown) {
      navbar.classList.add(...hideClassList);
    } else {
      navbar.classList.remove(...hideClassList);
    }
    prevScrollY = scrollY;
  };
  window.addEventListener("scroll", handleScroll);

  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll<HTMLAnchorElement>("#mainMenu .navbar-link")
      .forEach((el) => {
        el.addEventListener("click", () => {
          document.getElementById("mainMenu")?.hidePopover();
        });
      });
  });
</script>

<style is:global>
  @reference '@/styles/global.css';

  .navbar {
    @apply sticky top-0 inset-x-0 z-10 py-2 px-3 overflow-x-clip;
    @media (prefers-reduced-motion: no-preference) {
      transition: translate var(--default-transition-timing-function) 300ms;
    }
  }

  .navbar-container {
    @apply flex items-center justify-between gap-4;
  }

  .navbar-bar {
    @apply flex items-center justify-center p-1 gap-2 border rounded-full bg-background/50 backdrop-blur-xs;
  }

  .navbar-link {
    @apply font-semibold h-12 content-center px-5 rounded-full text-body hover:bg-primary/5 hover:no-underline;
    &[aria-current="page"] {
      @apply bg-primary text-background hover:bg-primary;
    }
  }

  .navbar-link-icon {
    @apply rounded-full p-3.5 text-body hover:bg-primary/5;
    &[aria-current="page"] {
      @apply bg-primary text-background hover:bg-primary;
    }
  }

  @media (width < 40rem) {
    #mainMenu {
      @apply fixed top-18 right-2.5 inset-auto z-10 items-stretch rounded-[1.75rem] flex-col;
      @media (prefers-reduced-motion: no-preference) {
        transition: all var(--default-transition-timing-function) 300ms;
        transition-behavior: allow-discrete;
      }
      &:not(:popover-open) {
        display: none;
        translate: calc(100% + var(--spacing) * 16);
      }
      @starting-style {
        &:popover-open {
          translate: calc(100% + var(--spacing) * 16);
        }
      }
    }
  }

  /* Source: https://uxdesign.cc/the-menu-210bec7ad80c */
  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 8;
    @media (prefers-reduced-motion: no-preference) {
      transition:
        stroke-dasharray,
        stroke-dashoffset var(--default-transition-timing-function) 300ms;
    }
  }
  .line1 {
    stroke-dasharray: 60 207;
    stroke-width: 8;
  }
  .line2 {
    stroke-dasharray: 60 60;
    stroke-width: 8;
  }
  .line3 {
    stroke-dasharray: 60 207;
    stroke-width: 8;
  }

  body:has(#mainMenu:popover-open) {
    .line1 {
      stroke-dasharray: 90 207;
      stroke-dashoffset: -134;
      stroke-width: 8;
    }
    .line2 {
      stroke-dasharray: 1 60;
      stroke-dashoffset: -30;
      stroke-width: 8;
    }
    .line3 {
      stroke-dasharray: 90 207;
      stroke-dashoffset: -134;
      stroke-width: 8;
    }
  }
</style>
