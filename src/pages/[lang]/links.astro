---
import networks from "@/data/networks";
import SimpleLayout from "@/layouts/SimpleLayout.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import Navbar from "@/components/Navbar.astro";
import { getLocaleParams } from "@/i18n/helpers";
import Hero from "@/sections/Hero.astro";
import Footer from "@/components/Footer.astro";

export const getStaticPaths = getLocaleParams;
---

<SimpleLayout title="Links" description="@vladiantio network links">
  <div class="wrapper">
    <Navbar />
    <main class="flex-1 px-5 my-8 place-content-center">
      <Hero hideLinks />
      <section class="grid sm:grid-cols-2 md:grid-cols-4 gap-6 pt-16">
        {
          networks.map((item) => (
            <ExternalLink
              class="networkLink liquid-glass-light"
              href={item.url}
            >
              <SocialIcon class="size-6" name={item.name.toLowerCase()} />
              <strong>{item.name}</strong>
            </ExternalLink>
          ))
        }
      </section>
    </main>
    <Footer />
  </div>
</SimpleLayout>

<style is:global>
  @reference '@/styles/global.css';

  .networkLink {
    @apply bg-primary/5 border text-center text-body hover:text-primary grid grid-cols-[1.5rem_1fr] px-5 py-4 rounded-full hover:bg-primary/10 hover:no-underline;
  }
</style>
